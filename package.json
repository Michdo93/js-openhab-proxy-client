{
  "name": "js-openhab-proxy-client",
  "version": "0.3.0",
  "description": "Browser client for cloudflare-openhab-rest-proxy with the same API as js-openhab-rest-client.",
  "type": "module",
  "main": "./openhab-proxy.mjs",
  "module": "./openhab-proxy.mjs",
  "types": "./openhab-proxy.d.ts",
  "exports": {
    ".": {
      "types": "./openhab-proxy.d.ts",
      "import": "./openhab-proxy.mjs"
    },
    "./script": "./openhab-proxy.min.js"
  },
  "files": ["openhab-proxy.js", "openhab-proxy.mjs", "openhab-proxy.min.js",
    "openhab-proxy.d.ts", "README.md", "LICENSE"],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/build.mjs && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "keywords": ["openhab", "smart-home", "dashboard", "cloudflare-workers", "sse"],
  "repository": "github:Michdo93/js-openhab-proxy-client",
  "license": "MIT"
}
